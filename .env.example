# ===== Rahasia server: hanya di .env VPS, JANGAN di repo/workflow =====
# Koneksi Postgres (dari /srv/postgres/newdb.sh). Host "postgres" = jaringan Docker appnet.
DATABASE_URL=postgresql://user:pass@postgres:5432/dbname

# Folder penyimpanan file upload (foto absen, PDF laporan, asesmen, modul).
# Di container di-mount dari volume Docker agar tidak hilang saat redeploy.
UPLOAD_DIR=/app/uploads

# (opsional) Super Admin pertama — dibuat otomatis saat start bila DB belum punya akun.
# Hapus password ini dari .env setelah berhasil login.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# (opsional) isi data demo saat start bila DB kosong. Jangan untuk produksi.
SEED_DEMO=false

# (opsional) ukuran pool koneksi DB per container
DB_POOL_MAX=5

# Ditanam saat build (ARG di Dockerfile + build-args di deploy.yml)
NEXT_PUBLIC_SITE_URL=
